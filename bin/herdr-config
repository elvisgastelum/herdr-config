#!/bin/sh
# Manage local backups and reloads; sync fast-forwards the trusted repository
# and links its port-forward plugin.
set -eu
home=${HOME:?HOME must be set}
config_home=${XDG_CONFIG_HOME:-$home/.config}
config_dir=$config_home/herdr
config=$config_dir/config.toml
backups=$config_dir/backups
safe_config_paths() {
    for path in "$home" "$config_home" "$config_dir" "$backups" "$config"; do
        if [ -L "$path" ]; then
            printf 'Refusing symlinked config path: %s\n' "$path" >&2
            return 1
        fi
    done
    if [ -e "$backups" ] && [ ! -d "$backups" ]; then
        printf 'Backup path is not a directory.\n' >&2
        return 1
    fi
    if [ ! -f "$config" ] || [ -L "$config" ]; then
        printf 'Current config must be a regular file.\n' >&2
        return 1
    fi
}
snapshot() {
    safe_config_paths || return 1
    mkdir -p "$backups" || return 1
    backup=$(mktemp "$backups/config.toml.bak.XXXXXX") || return 1
    if ! cp -p "$config" "$backup" || ! touch -m "$backup"; then
        rm -f -- "$backup"
        return 1
    fi
    printf 'Backed up config to %s\n' "$backup"
}
recognized() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    name=${1##*/}
    case $name in
        config.toml.bak.[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]) return 0 ;;
        herdr-config.bak.[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]) return 0 ;;
        herdr-config-skill.bak.[a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9][a-zA-Z0-9]) return 0 ;;
    esac
    return 1
}
check_backups() {
    for file in "$backups"/* "$backups"/.[!.]* "$backups"/..?*; do
        [ -e "$file" ] || [ -L "$file" ] || continue
        if ! recognized "$file"; then
            printf 'Refusing unknown or unsafe backup: %s\n' "$file" >&2
            return 1
        fi
    done
}
backup_time() {
    stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1"
}
clean_kind() {
    # Compare snapshot mtimes, not path-splitting ls output. A tie for newest
    # cannot establish a single survivor, so leave this kind untouched.
    newest=
    newest_time=
    tied=0
    for candidate in "$backups"/"$1".bak.*; do
        [ -f "$candidate" ] || continue
        time=$(backup_time "$candidate") || return 1
        if [ -z "$newest_time" ] || [ "$time" -gt "$newest_time" ]; then
            newest=$candidate
            newest_time=$time
            tied=0
        elif [ "$time" -eq "$newest_time" ]; then
            tied=1
        fi
    done
    [ "$tied" -eq 0 ] || return 0
    for candidate in "$backups"/"$1".bak.*; do
        [ -f "$candidate" ] || continue
        [ "$candidate" = "$newest" ] || rm -- "$candidate" || return 1
    done
}
restore() {
    safe_config_paths || return 1
    [ -d "$backups" ] || { printf 'No backups available.\n' >&2; return 1; }
    check_backups || return 1
    command -v fzf >/dev/null 2>&1 || { printf 'fzf is required for restore.\n' >&2; return 1; }
    tab=$(printf '\t')
    # Only config snapshots appear in the selection table.
    rows=
    for file in "$backups"/config.toml.bak.*; do
        [ -e "$file" ] || continue
        recognized "$file" || return 1
        created=$(stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$file" 2>/dev/null) ||
            created=$(stat -c '%y' "$file") || return 1
        size=$(stat -f '%z' "$file" 2>/dev/null) || size=$(stat -c '%s' "$file") || return 1
        rows="${rows}${file##*/}${tab}${created}${tab}${size}
"
    done
    [ -n "$rows" ] || { printf 'No config backups available.\n' >&2; return 1; }
    choice=$(printf 'NAME\tCREATED\tSIZE\n%s' "$rows" | fzf --header-lines=1) || return 1
    case $choice in *"$tab"*) selected=${choice%%"$tab"*} ;; *) return 1 ;; esac
    file=$backups/$selected
    recognized "$file" || return 1
    case $selected in config.toml.bak.*) ;; *) return 1 ;; esac
    # fzf output is untrusted: only a row actually offered in this table is valid.
    case "
$rows" in *"
$selected$tab"*) ;; *) return 1 ;; esac
    # Recheck immediately before copying, and stage beside the destination.
    safe_config_paths || return 1
    snapshot || return 1
    temp=$(mktemp "$config.tmp.XXXXXX") || return 1
    if ! recognized "$file" || ! cp -p "$file" "$temp"; then
        rm -f -- "$temp"
        return 1
    fi
    if [ -L "$config" ]; then rm -f -- "$temp"; return 1; fi
    if ! mv -f "$temp" "$config"; then rm -f -- "$temp"; return 1; fi
}
case ${1:-} in
    backup)
        case $#:${2:-} in
            1:*) snapshot; exit $? ;;
            2:--clean)
                safe_config_paths || exit 1
                [ -d "$backups" ] || exit 0
                check_backups || exit 1
                clean_kind config.toml && clean_kind herdr-config && clean_kind herdr-config-skill
                exit $? ;;
            2:restore) restore; exit $? ;;
            *) printf 'Usage: herdr-config backup [--clean|restore]\n' >&2; exit 2 ;;
        esac ;;
    reload)
        [ "$#" -eq 1 ] || exit 2
        herdr server reload-config
        exit $? ;;
    sync) [ "$#" -eq 1 ] || exit 2 ;;
    *) printf 'Usage: herdr-config {sync|backup [--clean|restore]|reload}\n' >&2; exit 2 ;;
esac
origin=git@github.com:elvisgastelum/herdr-config.git
repository=${HERDR_CONFIG_REPOSITORY:-$origin}
# The override exists for offline fixtures; reject option-like or relative paths.
if [ "$repository" != "$origin" ]; then
    case $repository in
        /*) [ -d "$repository" ] || { printf 'Invalid repository override.\n' >&2; exit 1; } ;;
        *) printf 'Repository override must be an absolute local directory.\n' >&2; exit 1 ;;
    esac
fi
home=${HOME:?HOME must be set}
if [ -n "${XDG_DATA_HOME:-}" ]; then
    data_home=$XDG_DATA_HOME
else
    data_home=$home/.local/share
fi
checkout=$data_home/herdr-config
# Ignore ambient Git settings that could execute hooks or change status/pull behavior.
# An existing checkout's local Git config and the remote remain trusted inputs.
safe_git() (
    unset GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_EXEC_PATH GIT_TEMPLATE_DIR GIT_SSH_COMMAND GIT_SSH
    GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
    export GIT_CONFIG_NOSYSTEM GIT_CONFIG_GLOBAL GIT_CONFIG_SYSTEM
    git -c core.hooksPath=/dev/null -c core.fsmonitor=false \
        -c init.templateDir= -c protocol.ext.allow=never "$@"
)
if [ -L "$home" ] || [ -L "$home/.local" ] || [ -L "$data_home" ] || [ -L "$checkout" ]; then
    printf 'Refusing symlinked checkout path: %s\n' "$checkout" >&2
    exit 1
fi
if [ ! -e "$checkout" ]; then
    mkdir -p "$data_home"
    safe_git clone --branch main --single-branch "$repository" "$checkout" || exit 1
else
    [ -d "$checkout" ] || { printf 'Checkout is not a directory.\n' >&2; exit 1; }
fi
# Validate before pulling or executing any installer from the checkout.
actual=$(safe_git -C "$checkout" rev-parse --show-toplevel 2>/dev/null) || exit 1
[ "$actual" = "$checkout" ] &&
    [ "$(safe_git -C "$checkout" remote get-url origin)" = "$repository" ] &&
    [ "$(safe_git -C "$checkout" symbolic-ref --quiet --short HEAD)" = main ] || {
    printf 'Checkout origin, branch, or root does not match expectations.\n' >&2
    exit 1
}
clean_checkout() {
    changes=$(safe_git -C "$checkout" status --porcelain --untracked-files=all) || return 1
    if [ -n "$changes" ]; then
        printf 'Refusing dirty checkout; local edits preserved: %s\n' "$checkout" >&2
        return 1
    fi
}
clean_checkout || exit 1
safe_git -C "$checkout" pull --ff-only origin main || {
    printf 'Fast-forward pull failed; deployed config unchanged.\n' >&2
    exit 1
}
clean_checkout || exit 1
[ -f "$checkout/install.sh" ] && [ ! -L "$checkout/install.sh" ] || {
    printf 'Checkout installer missing or symlinked.\n' >&2
    exit 1
}
HERDR_CONFIG_SOURCE="$checkout/config.toml" HERDR_UTILITY_SOURCE="$checkout/bin/herdr-config" \
    HERDR_SKILL_SOURCE="$checkout/skills/herdr-config/SKILL.md" \
    sh "$checkout/install.sh" || exit $?
# Register the port-forward plugin from the validated checkout. Config is
# already deployed, so failures here exit nonzero without rolling it back.
plugin_id=elvisgastelum.port-forward
plugin_dir=$checkout/plugins/port-forward
link_failed() {
    printf 'Config deployed, but the port-forward plugin is not registered: %s\n' "$1" >&2
    printf 'Fix the cause and rerun herdr-config sync, or run: herdr plugin link %s --enabled\n' "$plugin_dir" >&2
    exit 1
}
if [ -L "$checkout/plugins" ] || [ ! -d "$checkout/plugins" ] ||
    [ -L "$plugin_dir" ] || [ ! -d "$plugin_dir" ] ||
    [ -L "$plugin_dir/herdr-plugin.toml" ] || [ ! -f "$plugin_dir/herdr-plugin.toml" ]; then
    link_failed 'checkout plugin directory or manifest missing or symlinked'
fi
logical_plugin_dir=$plugin_dir
checkout_physical=$(cd -P -- "$checkout" && pwd -P) || link_failed 'cannot resolve checkout'
plugin_dir=$(cd -P -- "$plugin_dir" && pwd -P) || link_failed 'cannot resolve plugin directory'
case $plugin_dir in
    "$checkout_physical"/*) ;;
    *) link_failed 'plugin directory resolves outside the checkout' ;;
esac
command -v herdr >/dev/null 2>&1 || link_failed 'herdr is not on PATH'
command -v jq >/dev/null 2>&1 || link_failed 'jq is required to read the plugin list'
plugins=$(herdr plugin list --json) || link_failed 'herdr plugin list --json failed'
registered=$(printf '%s\n' "$plugins" | jq -r --arg id "$plugin_id" \
    'first(.result.plugins[]? | select(.plugin_id == $id) |
        "\(.enabled)\t\(.source.kind // "unknown")\t\(.plugin_root // "")") // empty') ||
    link_failed 'cannot parse herdr plugin list output'
if [ -z "$registered" ]; then
    herdr plugin link "$plugin_dir" --enabled || link_failed 'herdr plugin link failed'
    printf 'Linked port-forward plugin from %s\n' "$plugin_dir"
    exit 0
fi
tab=$(printf '\t')
enabled=${registered%%"$tab"*}
registered_root=${registered##*"$tab"}
registered_kind=${registered#*"$tab"}
registered_kind=${registered_kind%%"$tab"*}
if [ "$registered_root" != "$plugin_dir" ] && [ "$registered_root" != "$logical_plugin_dir" ]; then
    # Never replace a registration this checkout does not own.
    printf 'Port-forward plugin already registered from %s (%s); leaving it unchanged.\n' \
        "${registered_root:-unknown path}" "$registered_kind"
elif [ "$enabled" != true ]; then
    printf 'Port-forward plugin is linked but disabled; enable it with: herdr plugin enable %s\n' "$plugin_id"
fi
